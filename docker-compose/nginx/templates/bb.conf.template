server {
	listen      80;
	listen      [::]:80;

	server_name ${NGINX_BUILDBOT_VHOST} www.${NGINX_BUILDBOT_VHOST};
	server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
	}
}

# Per-client rate limited zone. This catches scanners walking many unique
# URLs without sharing one bucket across all visitors of a popular URL.
limit_req_zone $binary_remote_addr zone=bb:10m rate=35r/s;
# /avatar gets one request per unique commit author on a single page load
# (e.g. a changes/build page), so it needs a much more generous budget than
# the rest of the site.
limit_req_zone $binary_remote_addr zone=avatar:10m rate=100r/s;
client_max_body_size 10M;

# API collections that grow with every build. Buildbot reads and serialises
# the whole table, blocking the master, for a query without a limit, or with
# a filter or order on a field it can't run in SQL. Twisted splits arguments
# on ";" as well as "&", and decodes "%XX".
map "$uri?$args" $bb_api_heavy {
	default 1;
	# limit outside 1..9999, or above 999 for changes
	"~[?&;]limit=(?![1-9][0-9]{0,3}([&;]|$))" 1;
	"~^/api/v2/changes\?(.*[&;])?limit=[0-9]{4}" 1;
	# filter or order on a field Buildbot can't run in SQL
	"~[?&;](order=-?(files|properties|sourcestamps?|complete|claimed|branch)([&;]|$)|(files|properties|sourcestamps?)(=|__)|(complete|claimed|branch)__)" 1;
	"~[?&;](complete|claimed|branch)=.*[&;]\1=" 1;
	# percent-encoded argument name or order
	"~[?&;]([^=&;]*%|order=[^&;]*%)" 1;
	# a limit, or a filter the web UI sends without one
	"~[?&;](limit=|complete=false|claimed=false|buildrequestid=)" 0;
}

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;

	server_name ${NGINX_BUILDBOT_VHOST};

	proxy_set_header HOST $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto  $scheme;
	proxy_set_header X-Forwarded-Server  $host;
	proxy_set_header X-Forwarded-Host  $host;

	# Allow normal page/API bursts, but reject sustained aggressive clients.
	limit_req zone=bb burst=150 nodelay;
	limit_req_status 429;

	location / {
		proxy_pass http://127.0.0.1:8010;
	}

	# block heavy API calls, see $bb_api_heavy
	location ~ ^/api/v2/(builders/[^/]+/|workers/[^/]+/)?(builds|changes|buildsets|buildrequests)$ {
		if ($bb_api_heavy) {
			return 403 "Not allowed.\n";
		}
		proxy_pass http://127.0.0.1:8010;
	}
	# Buildbot reads the whole table for this one whatever the query
	location = /api/v2/sourcestamps {
		return 403 "Not allowed.\n";
	}

	# Avatars are fetched in bulk (one per commit author) when a
	# changes/build page loads, so give them their own, higher limit
	# instead of sharing the site-wide "bb" zone.
	location /avatar {
		limit_req zone=avatar burst=300 nodelay;
		proxy_pass http://127.0.0.1:8010;
	}

  # disallow bots
	location = /robots.txt {
		add_header Content-Type text/plain;
		return 200 "User-agent: *\nDisallow: /\n";
	}

	# Server sent event (sse) settings
	location /sse {
		proxy_buffering off;
		proxy_pass http://127.0.0.1:8010/sse;
	}

	# Websocket settings
	location /ws {
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_pass http://127.0.0.1:8010/ws;
		proxy_read_timeout 6000s;
	}

	#FIXME: CrossReference not in DEV.
	# Cross-reference
	location /cr/ {
		proxy_pass http://${NGINX_CR_HOST_WG_ADDR};
	}

	# disable logging for wsgi_dashboards/styles.css since it's generated
	# somewhere and mess with fail2ban //TEMP find the root cause!
	location ~ /wsgi_dashboards/styles.css* {
		access_log off;
	}
	location = /favicon.ico {
		alias /srv/buildbot/packages/favicon.ico;
	}
}
